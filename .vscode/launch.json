{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug VousCommandez",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/VousCommandez.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "environment": [
                {
                    // DLLs de SFML y MinGW están en ucrt64/bin
                    "name": "PATH",
                    "value": "C:/msys64/ucrt64/bin;${env:PATH}"
                }
            ],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "preLaunchTask": "Build VousCommandez",
            "setupCommands": [
                {
                    "description": "Pretty printing para gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}