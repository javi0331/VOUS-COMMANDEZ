{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build VousCommandez",
            "type": "shell",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-std=c++17",
                "-g",
                "-Wall",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/core/Node.cpp",
                "${workspaceFolder}/src/core/Edge.cpp",
                "${workspaceFolder}/src/core/Graph.cpp",
                "${workspaceFolder}/src/core/GraphLoader.cpp",
                "${workspaceFolder}/src/models/Order.cpp",
                "${workspaceFolder}/src/models/Dealer.cpp",
                "${workspaceFolder}/src/models/Restaurant.cpp",
                "${workspaceFolder}/src/models/Client.cpp",
                "${workspaceFolder}/src/algorithms/Dijkstra.cpp",
                "${workspaceFolder}/src/algorithms/BellmanFord.cpp",
                "${workspaceFolder}/src/structures/HeapDealers.cpp",
                "${workspaceFolder}/src/structures/PriorityQueueOrders.cpp",
                "${workspaceFolder}/src/structures/AVLRestaurants.cpp",
                "${workspaceFolder}/src/structures/DeliveryHistory.cpp",
                "${workspaceFolder}/src/simulation/TimeSystem.cpp",
                "${workspaceFolder}/src/simulation/WeatherSystem.cpp",
                "${workspaceFolder}/src/simulation/TrafficSystem.cpp",
                "${workspaceFolder}/src/simulation/EventSystem.cpp",
                "${workspaceFolder}/src/simulation/OrderGenerator.cpp",
                "${workspaceFolder}/src/simulation/Simulator.cpp",
                "${workspaceFolder}/src/utils/Logger.cpp",
                "${workspaceFolder}/src/utils/Random.cpp",
                "${workspaceFolder}/src/visual/Camera.cpp",
                "${workspaceFolder}/src/visual/UI.cpp",
                "${workspaceFolder}/src/visual/Animations.cpp",
                "${workspaceFolder}/src/visual/RendererSFML.cpp",
                "-I${workspaceFolder}/src",
                "-I${workspaceFolder}/src/core",
                "-I${workspaceFolder}/src/models",
                "-I${workspaceFolder}/src/algorithms",
                "-I${workspaceFolder}/src/structures",
                "-I${workspaceFolder}/src/simulation",
                "-I${workspaceFolder}/src/utils",
                "-I${workspaceFolder}/src/visual",
                "-IC:/msys64/ucrt64/include",
                "-o",
                "${workspaceFolder}/build/VousCommandez.exe",
                "-LC:/msys64/ucrt64/lib",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system"
            ],
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Compila todo el proyecto VousCommandez con g++ -std=c++17"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "C:/msys64/ucrt64/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        }
    ]
}